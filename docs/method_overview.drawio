          </mxGeometry>
        </mxCell>
        <mxCell id="e_apy_yield" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#d97706;strokeWidth=1.6;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="aux_apy" target="out_yield">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
